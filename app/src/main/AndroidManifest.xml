<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- phone info 读「网络是否连接」（ConnectivityManager.activeNetwork）需要它 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 侧载自用：需要真实 POSIX 路径让 shell 操作用户目录（SAF 的 URI 权限对 shell 无效） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 10 及以下：共享存储走运行时权限（10 起上面那条接管；maxSdkVersion 让它不在新系统上出现） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- 灵动岛（agent 干活时屏幕顶部那枚胶囊）：画在别的应用上面 = 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 后台保活：agent 那一轮跑到一半时不许被系统收走 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 电池优化白名单（国产 ROM 上不做这一项，前台服务照样会被清） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:name=".AdshApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ADSH">

        <!-- adjustResize 必须显式声明：默认的 adjustUnspecified 会被系统判定为 adjustPan，
             于是键盘弹出时窗口整体上移，再叠加 Compose 的 imePadding 就出现「输入框与键盘之间一大段空白」 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 灵动岛的宿主前台服务：agent 在跑时把进程钉住，同时挂那块悬浮窗 -->
        <service android:name=".island.IslandService" android:exported="false" />

        <!--
          PTC 程序的宿主进程：**独立进程**（dsh 的 dsh-ptc-runtime-node 也是每次调用 spawn 一个
          Node 子进程）。程序里的同步死循环只会烧死这个进程 —— 到点由主进程
          Process.killProcess 干掉它（见 core/ptc/PtcProcess 的 KDoc）。
        -->
        <service
            android:name=".core.ptc.PtcWorkerService"
            android:process=":ptc"
            android:exported="false" />
    </application>

</manifest>
