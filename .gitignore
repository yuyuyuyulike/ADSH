# 本地配置（不进版本库）
local.properties
keystore.properties
*.jks
*.keystore

# 构建产物
build/
.gradle/
.cxx/
*.apk
*.aab
captures/

# 大文件：由 scripts/fetch-tools.sh 与 PatchBootstrapTask 按 SHA 拉取
assets-src/bootstrap/*.zip
tools/prebuilt/
app/src/main/execLibs/

# IDE
.idea/
*.iml
.DS_Store

# bootstrap 压缩包由 scripts/fetch-bootstrap.sh 生成（32MB，不进库）
app/src/main/assets/bootstrap/*.zip

# 逐轮验证时抓的整机截图（每张 3.6MB）：只把 README 用到的那几张留下，新抓的 PNG 不入库
docs/screenshots/*.png

.tmp/
.transcript/

# 发布产物：APK 入库供下载
!dist/*.apk

# 本机备份（不进入版本库）
.backup/
